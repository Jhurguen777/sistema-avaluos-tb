# ============================================
# PRODUCCIÓN — GeoPricer Avalúos
# ============================================
# 1. Copia este archivo a .env:   cp .env.example .env
# 2. Completa los valores (los marcados como "cambia-esto").
# 3. El .env NUNCA se commitea (está en .gitignore).
# ============================================

# --------------------------------------------
# CONTRASEÑA DE LA BASE DE DATOS
# --------------------------------------------
# La usa el contenedor 'avaluos-db' (POSTGRES_PASSWORD) y para construir
# DATABASE_URL en docker-compose.prod.yml.
# Genera una fuerte con:  openssl rand -hex 14
POSTGRES_PASSWORD=cambia-esto-por-una-clave-fuerte

# --------------------------------------------
# NEXTAUTH (Autenticación)
# --------------------------------------------
# Llave para firmar sesiones JWT. Genera con:  openssl rand -base64 32
NEXTAUTH_SECRET=cambia-esto-por-una-clave-generada

# URL pública del dominio (con https)
NEXTAUTH_URL=https://avaluosbolivia.online
NEXT_PUBLIC_APP_URL=https://avaluosbolivia.online

# --------------------------------------------
# USUARIO ADMINISTRADOR INICIAL (seed)
# --------------------------------------------
# Se crea automáticamente en el primer arranque (idempotente).
# Puedes cambiar el email/contraseña acá o editarlos directo en la app después.
ADMIN_EMAIL=admin365soft777@gmail.com
ADMIN_PASSWORD=Superadmin123@
ADMIN_NAME=Administrador

# --------------------------------------------
# CONFIGURACIÓN DE LA APP
# --------------------------------------------
NEXT_PUBLIC_PDF_DOWNLOAD_TIMEOUT=30000

# Mapas (opcionales — OpenStreetMap es gratuito por defecto)
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Overpass (radar de equipamientos). Opcional: si se define, se usa ese endpoint
# en lugar de la lista de espejos públicos (overpass-api.de, kumi, openstreetmap.fr).
OVERPASS_URL=

# Rate Limiting (protección contra fuerza bruta)
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MS=900000

# ============================================
# NOTA: DATABASE_URL NO se define aquí.
# La construye automáticamente docker-compose.prod.yml usando
# POSTGRES_PASSWORD y el host interno 'avaluos-db'.
# ============================================

# --------------------------------------------
# SCRAPER
# --------------------------------------------
# Limite de tiempo por URL en minutos (default 30).
# Al vencer, esa URL se marca como ERROR y el lote continua con la siguiente.
SCRAPER_LIMITE_MIN=30
