# ============================================
# BASE DE DATOS
# ============================================
# PostgreSQL con PostGIS
DATABASE_URL="postgresql://geopricer_user:geopricer_pass@localhost:5432/geopricer_avaluos?schema=public"

# ============================================
# AUTENTICACIÓN
# ============================================
# NextAuth
NEXTAUTH_SECRET="cambia-esto-por-una-clave-super-segura-en-produccion"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# ALMACENAMIENTO (MinIO/S3)
# ============================================
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_USE_SSL="false"
MINIO_BUCKET="geopricer-avaluos"

# ============================================
# API EXTERNAS
# ============================================
# Mapas (OpenStreetMap es gratuito)
# Opcionales: Google Maps, Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PDF_DOWNLOAD_TIMEOUT="30000"

# ============================================
# CONFIGURACIÓN ADICIONAL
# ============================================
# Node environment
NODE_ENV="development"

# Port (opcional, por defecto 3000)
PORT=3000

# ============================================
# SEGURIDAD
# ============================================
# Rate Limiting - Protección contra fuerza bruta
RATE_LIMIT_MAX_ATTEMPTS="5"
RATE_LIMIT_WINDOW_MS="900000"

# CAPTCHA - Protección contra bots (opcional, usar reCAPTCHA v3)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Session Management
SESSION_MAX_AGE="28800"

# Email Verification (opcional)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
